<% layout("Layouts/boilerplate") %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
      <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body text-center p-5">
          <div class="mb-4">
            <i class="fas fa-exclamation-triangle fa-4x text-danger mb-3"></i>
            <h1 class="display-4 fw-bold text-danger mb-3">Oops!</h1>
            <h3 class="mb-4">Something went wrong</h3>
          </div>
          <div class="alert alert-danger border-0 shadow-sm" role="alert">
            <h5 class="alert-heading mb-2">
              <i class="fas fa-info-circle me-2"></i>Error Details
            </h5>
            <p class="mb-0"><%= message %></p>
          </div>
          <div class="mt-4">
            <a href="/listings" class="btn btn-primary btn-lg me-3">
              <i class="fas fa-home me-2"></i>Go to Listings
            </a>
            <button onclick="history.back()" class="btn btn-secondary btn-lg">
              <i class="fas fa-arrow-left me-2"></i>Go Back
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
