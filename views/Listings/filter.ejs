<% layout("Layouts/boilerplate") %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <%for(let listing of allListings){%>
  <a class="card-container" href="/listings/<%=listing._id%>">
    <div class="card listings-card">
      <img src="<%-listing.image.url%>" class="card-img-top" alt="listing-image" />
      <div class="card-img-overlay"></div>
      <div class="card-body">
      <p class="card-text">
      <b><%- listing.title %></b>
      <br />

      <% 
        const price = Number(listing.price);
        const gst = price * 18 / 100;
        const total = price + gst;
      %>

      Price: &#8377;<%= price.toLocaleString("en-IN") %> /night  
      <i class="gst-price" style="display: inline;">
        <b>+ 18% GST</b> = &#8377;<%= total.toLocaleString("en-IN") %>
      </i>
    </p>

      </div>
    </div>
  </a>
  <%}%>
</div>

<script>
  const tax_btn = document.getElementById("switchCheckDefault");
  tax_btn.addEventListener("click", () => {
    const gst_price=document.getElementsByClassName("gst-price")
    for(let info of gst_price){
      if(info.style.display!="inline"){
        info.style.display="inline"
      }else{
        info.style.display="none"
      }
    }
  });
</script>
