<% layout("Layouts/boilerplate") %>
<style>
  
  .filters:hover{
  opacity:1;
  cursor: pointer;
  }
  #filter{
    display: flex;
    text-align: center;
  }
  .filters{
    opacity: 0.8;
    margin: 12px  3rem;
  }
  .tax-btn:hover{
cursor: pointer;
}

.tax-btn-container{
  margin-bottom: 15px;
  color: #ff385c;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid grey;
  border-radius: 8px;
  padding: 5px;
}

  .gst-price{
    display: none;
  }
</style>
  <div id="filter">
    <a href="/listings/category/Trending" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
    </a>
    <a href="/listings/category/Rooms" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  </a>
  <a href="/listings/category/Beaches" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beaches</p>
  </div>
  </a>
  <a href="/listings/category/Mountains" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  </a>
  <a href="/listings/category/Pools" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Pools</p>
  </div>
  </a>
  <a href="/listings/category/Camping" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-tent"></i></div>
    <p>Camping</p>
  </div>
  </a>
  <a href="/listings/category/Cities" class="filter-links">
  <div class="filters">
    <div><i class="fa-solid fa-city"></i></div>
    <p>Cities</p>
  </div>
  </a>
  <a href="/listings/category/Castle" class="filter-links">
  <div class="filters">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castle</p>
  </div>
  </a>
  <div class="tax-btn-container" >
  <div class="form-check-reverse  form-switch ">
  <input class="form-check-input tax-btn" type="checkbox" role="switch" id="switchCheckDefault">
  <label  class="form-check-label tax-btn" for="switchCheckDefault">Apply Taxes</label>
  </div>
</div>
  
  </div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
  <% for (let listing of allListings) { %>
    <div class="col">
      <a class="card-container text-decoration-none" href="/listings/<%= listing._id %>">
        <div class="card listings-card h-100 shadow-sm">
          <div class="position-relative">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" />
            <div class="card-img-overlay d-flex align-items-end">
              <div class="bg-dark bg-opacity-50 text-white p-2 rounded">
                <small><%= listing.category %></small>
              </div>
            </div>
          </div>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold text-dark mb-2"><%= listing.title %></h5>
            <p class="card-text text-muted mb-2">
              <i class="fas fa-map-marker-alt me-1"></i><%= listing.location %>, <%= listing.country %>
            </p>
            <div class="mt-auto">
              <%
                const price = Number(listing.price);
                const gst = price * 18 / 100;
                const total = price + gst;
              %>
              <p class="card-text mb-1">
                <span class="h6 text-success fw-bold">₹<%= price.toLocaleString("en-IN") %> / night</span>
              </p>
              <p class="card-text gst-price" style="display: none;">
                <small class="text-muted">+ 18% GST = ₹<%= total.toLocaleString("en-IN") %></small>
              </p>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  const tax_btn = document.getElementById("switchCheckDefault");
  tax_btn.addEventListener("click", () => {
    const gst_price=document.getElementsByClassName("gst-price")
    for(let info of gst_price){
      if(info.style.display!="inline"){
        info.style.display="inline"
      }else{
        info.style.display="none"
      }
    }
  });
</script>
