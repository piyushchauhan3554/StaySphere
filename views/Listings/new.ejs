<% layout("Layouts/boilerplate") %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white text-center py-4">
          <h2 class="mb-0 fw-bold">
            <i class="fas fa-plus-circle me-2"></i>Add New Listing
          </h2>
          <p class="mb-0 mt-2">Share your amazing stay with the world!</p>
        </div>
        <div class="card-body p-5">
          <form
            action="/listings"
            method="POST"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
          >
            <div class="row">
              <div class="col-md-6 mb-4">
                <label for="title" class="form-label fw-bold">
                  <i class="fas fa-heading me-2 text-primary"></i>Title
                </label>
                <input
                  name="listings[title]"
                  type="text"
                  placeholder="Enter a catchy title"
                  class="form-control form-control-lg"
                  required
                />
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">
                  Please enter a title for the listing.
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <label for="category" class="form-label fw-bold">
                  <i class="fas fa-tags me-2 text-primary"></i>Category
                </label>
                <select
                  class="form-select form-control-lg"
                  name="listings[category]"
                  required
                >
                  <option value="" disabled selected>Select category</option>
                  <option value="Trending">🔥 Trending</option>
                  <option value="Rooms">🏠 Rooms</option>
                  <option value="Beaches">🏖️ Beaches</option>
                  <option value="Mountains">🏔️ Mountains</option>
                  <option value="Pools">🏊 Pools</option>
                  <option value="Camping">⛺ Camping</option>
                  <option value="Cities">🏙️ Cities</option>
                  <option value="Castle">🏰 Castle</option>
                  <option value="Others">📍 Others</option>
                </select>
                <div class="invalid-feedback">Please select a category.</div>
              </div>
            </div>

            <div class="mb-4">
              <label for="description" class="form-label fw-bold">
                <i class="fas fa-align-left me-2 text-primary"></i>Description
              </label>
              <textarea
                name="listings[description]"
                class="form-control form-control-lg"
                rows="4"
                placeholder="Describe your listing..."
                required
              ></textarea>
              <div class="valid-feedback">Description looks good.</div>
              <div class="invalid-feedback">
                Please provide a brief description.
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-4">
                <label for="price" class="form-label fw-bold">
                  <i class="fas fa-rupee-sign me-2 text-primary"></i>Price (per
                  night)
                </label>
                <div class="input-group input-group-lg">
                  <span class="input-group-text">₹</span>
                  <input
                    name="listings[price]"
                    placeholder="1200"
                    class="form-control"
                    required
                    type="number"
                  />
                </div>
                <div class="valid-feedback">Valid price.</div>
                <div class="invalid-feedback">
                  Please enter a valid price (numbers only).
                </div>
              </div>
              <div class="col-md-6 mb-4">
                <label for="country" class="form-label fw-bold">
                  <i class="fas fa-globe me-2 text-primary"></i>Country
                </label>
                <input
                  type="text"
                  name="listings[country]"
                  placeholder="India"
                  class="form-control form-control-lg"
                  required
                />
                <div class="valid-feedback">Country name looks good.</div>
                <div class="invalid-feedback">
                  Please enter a valid country name.
                </div>
              </div>
            </div>

            <div class="mb-4">
              <label for="location" class="form-label fw-bold">
                <i class="fas fa-map-marker-alt me-2 text-primary"></i>Location
              </label>
              <input
                type="text"
                name="listings[location]"
                placeholder="Mumbai, Maharashtra"
                class="form-control form-control-lg"
                required
              />
              <div class="valid-feedback">Location looks good.</div>
              <div class="invalid-feedback">Please enter the location.</div>
            </div>

            <div class="mb-4">
              <label for="image" class="form-label fw-bold">
                <i class="fas fa-camera me-2 text-primary"></i>Upload Image
              </label>
              <input
                type="file"
                name="listings[image]"
                class="form-control form-control-lg"
                required
              />
              <div class="form-text">
                Upload a high-quality image of your listing.
              </div>
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-plus me-2"></i>Add Listing
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
