<% layout("Layouts/boilerplate") %>
<div class="container mt-5">
  <div class="row">
    <div class="col-12 text-center mb-4">
      <h1 class="display-4 fw-bold text-primary"><%= list.title %></h1>
      <p class="lead text-muted"><%= list.location %>, <%= list.country %></p>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-8 col-md-7 mb-4">
      <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
        <img class="card-img-top show-img" src="<%= list.image.url %>" alt="<%= list.title %>" />
        <div class="card-body p-4">
          <div class="row">
            <div class="col-md-6">
              <h5 class="card-title fw-bold text-dark">About this place</h5>
              <p class="card-text text-muted"><%= list.description %></p>
            </div>
            <div class="col-md-6">
              <div class="bg-light p-3 rounded-3">
                <p class="mb-2"><strong>Owned by:</strong> <span class="text-primary">@<%= list.owner.username %></span></p>
                <p class="mb-2"><strong>Price:</strong> <span class="h5 text-success">₹<%= list.price.toLocaleString('en-IN') %> / night</span></p>
                <p class="mb-0"><strong>Location:</strong> <%= list.location %>, <%= list.country %></p>
              </div>
            </div>
          </div>
          <% if (currUser && list.owner._id.equals(currUser._id)) { %>
            <div class="d-flex gap-3 mt-4">
              <a href="/listings/<%= list._id %>/edit" class="btn btn-warning btn-lg flex-fill">
                <i class="fas fa-edit me-2"></i>Edit Listing
              </a>
              <form action="/listings/<%= list._id %>?_method=DELETE" method="post" class="flex-fill">
                <button type="submit" class="btn btn-danger btn-lg w-100" onclick="return confirm('Are you sure you want to delete this listing?')">
                  <i class="fas fa-trash me-2"></i>Delete Listing
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-4 col-md-5">
      <% if (currUser) { %>
        <div class="card shadow-lg border-0 rounded-3 mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-star me-2"></i>Leave a Review</h5>
          </div>
          <div class="card-body">
            <form method="post" action="/listings/<%= list._id %>/reviews" novalidate class="needs-validation">
              <div class="mb-3">
                <label for="rating" class="form-label fw-bold">Rating</label>
                <fieldset class="starability-heartbeat" id="rating">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label fw-bold">Comment</label>
                <textarea name="review[comment]" rows="4" class="form-control" placeholder="Share your experience..." required id="comment"></textarea>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please write a comment.</div>
              </div>
              <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="fas fa-paper-plane me-2"></i>Submit Review
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Location</h5>
        </div>
        <div class="card-body p-0">
          <div id="map" class="rounded-bottom"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-5">
    <div class="col-12">
      <h3 class="mb-4 text-center fw-bold">Reviews</h3>
      <% if (!list.reviews.length) { %>
        <div class="text-center py-5">
          <i class="fas fa-comments fa-3x text-muted mb-3"></i>
          <p class="text-muted">No reviews yet. Be the first to share your experience!</p>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% for (let review of list.reviews) { %>
            <div class="col-md-6">
              <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                  <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                      <i class="fas fa-user"></i>
                    </div>
                    <div class="ms-3">
                      <h6 class="mb-0 fw-bold">@<%= review.author.username %></h6>
                      <p class="starability-result text-warning mb-0" data-rating="<%= review.rating %>"></p>
                    </div>
                  </div>
                  <p class="card-text"><%= review.comment %></p>
                  <% if (currUser && currUser._id.equals(review.author._id)) { %>
                    <form action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mt-3">
                      <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this review?')">
                        <i class="fas fa-trash me-1"></i>Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  const points = <%- JSON.stringify(list.coordinates) %>;
  const loc = <%- JSON.stringify(list.location) %>;
</script>
