<% layout("Layouts/boilerplate") %>
<script>
  const points=<%-JSON.stringify(list.coordinates)%>;
  const loc=<%-JSON.stringify(list.location)%>;
</script>
<div class="row">
  <div class="col-8 offset-2 listing-heading">
    <b><h3><%=list.title%></h3></b>
  </div>
  <div class="card listings-card show-card col-6 offset-2">
    <img class="show-img" src="<%=list.image.url%>" />
    <div class="info-container mt-3">
      <p><b>Owned By: </b><i><%=list.owner.username%></i></p>
      <p><b>Description:</b> <%=list.description%></p>
      <p><b>Price:</b> &#8377;<%= list.price.toLocaleString('en-IN') %></p>
      <p><b>Location:</b> <%=list.location%>, <%=list.country%></p>
    </div>
    <%if(currUser && list.owner._id.equals(currUser._id)){%>
    <div class="show-btns-containers">
      <form action="/listings/<%=list._id%>/edit" method="get">
        <button class="btn show-edit-btn">Edit</button>
      </form>
      <form action="/listings/<%=list._id%>?_method=DELETE" method="post">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
    <%}%>

    <hr />
    <div>
      <%if(currUser){%>
      <h5 style="color: #ff385c"><b>Leave a Review</b></h5>
      <form 
        method="post"
        action="/listings/<%=list._id%>/reviews"
        novalidate
        class="needs-validation mb-4"
      >
        <label for="rating" class="form-label">Rating</label>
      
        <fieldset class="starability-heartbeat card-text" id="rating">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>

        <label for="comment" class="form-label">Comment</label>
        <div>
          <textarea
            name="review[comment]"
            rows="5"
            cols="10"
            class="form-control"
            placeholder="write your experience here..."
            required
            id="comment"
          ></textarea>

          <div class="valid-feedback">seems a good comment</div>
          <div class="invalid-feedback">
            please fill the comment before submit
          </div>
        </div>

        <button class="btn-dark btn mt-3">submit</button>
      </form>
      <%}%>
      
      <p><b>All Reviews</b></p>
      <div class="row ">
        <%if(!list.reviews.length){%>
        <p>No reviews yet</p>
        <%}else{%> <%for(let review of list.reviews){%>
        <div class="card col-5 ms-3 mb-4">
          <div class="card-body">
            <h6 class="card-title"><b>Added By: @</b><i><%=review.author.username%></i></h6>
            <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
            <p class="card-text"><%=review.comment%></p>
          </div>
          <form
            action="/listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE"
            method="post"
          >
           <%if(currUser && currUser._id.equals(review.author._id)){%>
            <button class="btn btn-danger mt-3 mb-3">Delete</button>
          <%}%>
          </form>
        </div>
        <%}%> <%}%>
      </div>

      <p><b>Location : </b>Where you'll be</p>
      <div id="map"></div>

    </div>

  </div>
</div>
